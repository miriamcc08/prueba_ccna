DATABASE_URL=file:./dev.db
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Set JWT_SECRET securely before using production mode.
# Administrator creation is optional: set ADMIN_EMAIL and ADMIN_PASSWORD securely.

# CORS_ORIGIN accepts comma-separated exact origins; required in production.
# For admin:bootstrap, provide ADMIN_EMAIL and ADMIN_PASSWORD via secure environment settings.
